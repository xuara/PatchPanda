[*.cs]
# Performance: Use LoggerMessage instead of LogInformation/Error (CA1848)
dotnet_diagnostic.CA1848.severity = none
# Library Best Practice: ConfigureAwait(false) (CA2007)
dotnet_diagnostic.CA2007.severity = none
# Globalization: Culture-aware string operations (CA1305, CA1307, CA1310)
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
# Silence logging and specific style noise
dotnet_diagnostic.CA2254.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1304.severity = none
# Performance: Avoid expensive logic in logging arguments (CA1873)
dotnet_diagnostic.CA1873.severity = none
# Design: Mark members as static (CA1822)
dotnet_diagnostic.CA1822.severity = none
# EF Core/Serialization Generic noise
dotnet_diagnostic.CA2263.severity = none